<?xml version="1.0" encoding="utf-8"?>
<!-- Тестовая сборка под ЧИСТЫМ applicationId com.djiquicktest (никогда не имел appops-грантов),
     чтобы проверить обычную установку из APK без выдачи разрешений через telnet.
     Java-классы остаются в пакете com.djiquick → в компонентах указаны полные имена. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.djiquicktest"
    android:versionCode="1"
    android:versionName="0.1t">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <queries>
        <package android:name="dji.go.v6" />
        <package android:name="dji.go.v5" />
        <package android:name="com.dpad.fuli" />
    </queries>

    <application
        android:label="GPS/LED TEST"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name="com.djiquick.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.djiquick.OverlayService"
            android:exported="false" />
    </application>
</manifest>
