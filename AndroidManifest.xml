<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.djiquick"
    android:versionCode="18"
    android:versionName="0.18">

    <!-- ПРАВИЛО ВЕРСИЙ: versionName = 0.NN, versionCode = NN. Бампать КАЖДЫЙ деплой.
         Пока манифест стоял на 0.1, по телеметрии нельзя было отличить старую сборку
         от новой — и «поиск ничего не находит» списывали на дрон, а не на устаревший APK. -->

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />

    <!-- loopback TCP к DUML-фидам пульта (40007/40008) + телеметрия подключения по HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- проверка наличия сети перед отправкой телеметрии (иначе — в очередь) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- плавающее меню поверх DJI Fly -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- обновление из релизов GitHub: скачиваем APK и ставим через PackageInstaller -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- видимость пакетов Android 11: резолвим DJI Fly и открываем её «О приложении» -->
    <queries>
        <package android:name="dji.go.v6" />
        <package android:name="dji.go.v5" />
        <package android:name="dji.go.v4" />
        <package android:name="com.dji.industry.pilot" />
        <package android:name="com.dpad.fuli" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density" />
        <service
            android:name=".OverlayService"
            android:exported="false" />
        <!-- статус сессии PackageInstaller при самообновлении -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
